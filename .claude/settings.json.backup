      "Edit(dev-docs/**)",
      "Write(dev-docs/**)",
      "Read(dev-docs/**)",
      "Edit(**/dev-docs/**)",
      "Write(**/dev-docs/**)",
      "Read(**/dev-docs/**)",
      "Bash(hep_q:*)",
      "Bash(hep_q *)",
