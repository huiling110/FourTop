      "Bash(tail *)",
      "Bash(find:*)",
      "Bash(find *)",
      "Bash(pwd:*)",
      "Bash(pwd)",
      "Bash(cd:*)",
      "Bash(cd *)",
      "Bash(echo:*)",
      "Bash(echo *)",
      "Bash(which:*)",
      "Bash(which *)",
      "Bash(env:*)",
      "Bash(env)",
      "Bash(date:*)",
      "Bash(date)",
      "Bash(du:*)",
      "Bash(du *)",
      "Bash(df:*)",
      "Bash(df *)",
      "Bash(stat:*)",
      "Bash(stat *)",
      "Bash(file:*)",
      "Bash(file *)",
      "Bash(diff:*)",
      "Bash(diff *)",
      "Bash(sort:*)",
      "Bash(sort *)",
      "Bash(uniq:*)",
      "Bash(uniq *)",
      "Bash(awk:*)",
      "Bash(awk *)",
      "Bash(sed:*)",
      "Bash(sed *)",
      "Bash(tr:*)",
      "Bash(tr *)",
      "Bash(cut:*)",
      "Bash(cut *)",
      "Bash(xargs:*)",
      "Bash(xargs *)",
      "Bash(tee:*)",
      "Bash(tee *)",
      "Bash(basename:*)",
      "Bash(basename *)",
      "Bash(dirname:*)",
      "Bash(dirname *)",
      "Bash(realpath:*)",
      "Bash(realpath *)",
      "Bash(mkdir:*)",
      "Bash(mkdir *)",
      "Bash(cp:*)",
      "Bash(cp *)",
      "Bash(mv:*)",
      "Bash(mv *)",
      "Bash(touch:*)",
      "Bash(touch *)",
      "Bash(tree:*)",
      "Bash(tree *)",
      "Bash(time:*)",
      "Bash(time *)",
      "Bash(source setEnv*)",
      "Bash(nohup *)",
      "Bash(nohup:*)",
      "Bash(for *)",
      "Bash(timeout *)",
      "Bash(cd /workfs2/*)",
      "Bash(source * && cd * && python3 *)",
      "Bash(source * && python3 *)",
      "Bash(cd * && python3 *)",
      "Bash(source * && *)",
      "Bash(cd * && *)",
      "Bash(* && python3 *)",
      "Bash(* | tail *)",
      "Bash(* | head *)",
      "Bash(* | wc *)",
      "Bash(* | grep *)",
      "Bash(* 2>&1 | *)"
    ]
  },
  "hooks": {
    "userPromptSubmit": {
      "command": "bash",
      "args": [".claude/hooks/user-prompt-submit.sh"],
      "env": {
        "USER_PROMPT": "{{user_prompt}}",
        "PROJECT_ROOT": "{{project_root}}"
      }
    },
    "preToolUse": {
      "command": "bash",
      "args": [".claude/hooks/pre-tool-use.sh"],
      "env": {
        "TOOL_NAME": "{{tool_name}}",
        "BASH_COMMAND": "{{bash_command}}",
        "PROJECT_ROOT": "{{project_root}}"
      }
    },
    "postToolUse": {
      "command": "bash",
      "args": [".claude/hooks/post-tool-use.sh"],
      "env": {
        "TOOL_NAME": "{{tool_name}}",
        "FILE_PATH": "{{file_path}}",
        "PROJECT_ROOT": "{{project_root}}"
      }
    }
  },
  "codeQuality": {
    "python": {
      "maxFunctionLines": 80,
      "recommendedFunctionLines": 50,
      "maxNestingDepth": 5,
      "recommendedNestingDepth": 3,
      "maxBranches": 20,
      "recommendedBranches": 10,
      "maxFileLines": 1000,
      "recommendedFileLines": 500
    },
    "cpp": {
      "maxFunctionLines": 150,
      "maxFileLines": 800
    }
  },
  "comments": [
    "This settings.json enables code quality and workflow hooks for the FourTop analysis project",
    "The userPromptSubmit hook auto-activates workflow skill based on keywords",
    "The preToolUse hook checks environment setup before running analysis scripts",
    "The postToolUse hook runs after Edit/Write operations to check code quality",
    "See .claude/hooks/ directory and .claude/skills/ for implementations"
  ]
}
