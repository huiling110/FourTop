{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/workfs2/cms/huahuil",
        "/publicfs/cms",
        "/hpcfs/cms/cmsgpu/huahuil"
      ],
      "disabled": false,
      "autoApprove": [
        "read_file",
        "read_multiple_files",
        "list_directory",
        "search_files",
        "get_file_info"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "disabled": false,
      "autoApprove": [
        "store_memory",
        "retrieve_memory",
        "search_memory"
      ]
    }
  }
}
