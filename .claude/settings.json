{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Edit(//workfs2/cms/huahuil/CMSSW_14_1_0_pre4/src/FourTop/dev-docs/**)",
      "Write(//workfs2/cms/huahuil/CMSSW_14_1_0_pre4/src/FourTop/dev-docs/**)",
      "Read(//workfs2/cms/huahuil/CMSSW_14_1_0_pre4/src/FourTop/dev-docs/**)",
      "Edit(dev-docs/**)",
      "Write(dev-docs/**)",
      "Read(dev-docs/**)",
      "Edit(**/dev-docs/**)",
      "Write(**/dev-docs/**)",
      "Read(**/dev-docs/**)",
      "Bash(hep_q:*)",
      "Bash(hep_q *)",
      "Bash(condor_q:*)",
      "Bash(ls:*)",
      "Bash(ls *)",
      "Bash(wc:*)",
      "Bash(make:*)",
      "Bash(source:*)",
      "Bash(cat .workflow_state.json*)",
      "Bash(grep:*)"
    ]
  },
  "hooks": {
    "userPromptSubmit": {
      "command": "bash",
      "args": [".claude/hooks/user-prompt-submit.sh"],
      "env": {
        "USER_PROMPT": "{{user_prompt}}",
        "PROJECT_ROOT": "{{project_root}}"
      }
    },
    "preToolUse": {
      "command": "bash",
      "args": [".claude/hooks/pre-tool-use.sh"],
      "env": {
        "TOOL_NAME": "{{tool_name}}",
        "BASH_COMMAND": "{{bash_command}}",
        "PROJECT_ROOT": "{{project_root}}"
      }
    },
    "postToolUse": {
      "command": "bash",
      "args": [".claude/hooks/post-tool-use.sh"],
      "env": {
        "TOOL_NAME": "{{tool_name}}",
        "FILE_PATH": "{{file_path}}",
        "PROJECT_ROOT": "{{project_root}}"
      }
    }
  },
  "codeQuality": {
    "python": {
      "maxFunctionLines": 80,
      "recommendedFunctionLines": 50,
      "maxNestingDepth": 5,
      "recommendedNestingDepth": 3,
      "maxBranches": 20,
      "recommendedBranches": 10,
      "maxFileLines": 1000,
      "recommendedFileLines": 500
    },
    "cpp": {
      "maxFunctionLines": 150,
      "maxFileLines": 800
    }
  },
  "comments": [
    "This settings.json enables code quality and workflow hooks for the FourTop analysis project",
    "The userPromptSubmit hook auto-activates workflow skill based on keywords",
    "The preToolUse hook checks environment setup before running analysis scripts",
    "The postToolUse hook runs after Edit/Write operations to check code quality",
    "See .claude/hooks/ directory and .claude/skills/ for implementations"
  ]
}
