{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Edit(//workfs2/cms/huahuil/CMSSW_14_1_0_pre4/src/FourTop/.claude/dev-docs/**)",
      "Write(//workfs2/cms/huahuil/CMSSW_14_1_0_pre4/src/FourTop/.claude/dev-docs/**)",
      "Read(//workfs2/cms/huahuil/CMSSW_14_1_0_pre4/src/FourTop/.claude/dev-docs/**)",
      "Edit(.claude/dev-docs/**)",
      "Write(.claude/dev-docs/**)",
      "Read(.claude/dev-docs/**)",
      "Edit(**/.claude/dev-docs/**)",
      "Write(**/.claude/dev-docs/**)",
      "Read(**/.claude/dev-docs/**)",
      "Bash(hep_q:*)",
      "Bash(ls:*)",
      "Bash(make:*)",
      "Bash(source:*)"
    ]
  },
  "hooks": {
    "preToolUse": {
      "command": "bash",
      "args": [".claude/hooks/pre-tool-use.sh"],
      "env": {
        "TOOL_NAME": "{{tool_name}}",
        "BASH_COMMAND": "{{bash_command}}",
        "PROJECT_ROOT": "{{project_root}}"
      }
    },
    "postToolUse": {
      "command": "bash",
      "args": [".claude/hooks/post-tool-use.sh"],
      "env": {
        "TOOL_NAME": "{{tool_name}}",
        "FILE_PATH": "{{file_path}}",
        "PROJECT_ROOT": "{{project_root}}"
      }
    }
  },
  "codeQuality": {
    "python": {
      "maxFunctionLines": 80,
      "recommendedFunctionLines": 50,
      "maxNestingDepth": 5,
      "recommendedNestingDepth": 3,
      "maxBranches": 20,
      "recommendedBranches": 10,
      "maxFileLines": 1000,
      "recommendedFileLines": 500
    },
    "cpp": {
      "maxFunctionLines": 150,
      "maxFileLines": 800
    }
  },
  "comments": [
    "This settings.json enables code quality and workflow hooks for the FourTop analysis project",
    "The preToolUse hook checks environment setup before running analysis scripts",
    "The postToolUse hook runs after Edit/Write operations to check code quality",
    "Thresholds are defined in the codeQuality section for reference",
    "See .claude/hooks/ directory for hook implementations"
  ]
}
